# Copy this to `.env` to run the whiteboard locally, and to `.env.prod` to
# build the version that goes on the web.
#
# These are read when the app is BUILT, not when it runs, so change one and you
# have to build again. Nothing in here is secret. The shared password lives on
# the board server, never in the app.

# Leave DEV=true in `.env` and leave it out of `.env.prod`.
DEV=true

HOST=localhost

CLIENT_PORT=60379
CLIENT_URL=http://${HOST}:${CLIENT_PORT}

# Where boards live. The app turns this into an https address of its own accord
# when it needs to ask for a pass, so only set the ws or wss one.
COLLAB_SERVER_URL=wss://deepboard-server.yt3dp.workers.dev
